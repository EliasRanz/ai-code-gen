# Mock AI Service Dockerfile
FROM alpine:latest

# Install required packages
RUN apk add --no-cache bash python3 py3-pip netcat-openbsd

# Create app directory
WORKDIR /app

# Copy the mock service script
COPY scripts/development/mock-ai-service.sh /app/mock-ai-service.sh

# Make it executable
RUN chmod +x /app/mock-ai-service.sh

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://0.0.0.0:8000/health || exit 1

# Start the service
CMD ["/app/mock-ai-service.sh"]